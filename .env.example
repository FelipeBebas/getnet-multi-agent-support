# ==============================================================================
# Getnet Multi-Agent Support System - Environment Configuration
# ==============================================================================

# --- Application & Runtime ---
APP_NAME="Getnet Multi-Agent Support System"
APP_VERSION="1.0.0"
APP_ENV="development"
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000

# --- LLM & Embeddings Configuration ---
# Set LLM_PROVIDER="openai" when OPENAI_API_KEY is configured, or "auto" to
# automatically fall back to deterministic local execution when no key is set.
LLM_PROVIDER="auto"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_TEMPERATURE_ROUTER=0.0
OPENAI_TEMPERATURE_AGENT=0.1
OPENAI_TEMPERATURE_PERSONALITY=0.2

# --- Knowledge Base (RAG) & Vector Store ---
CHROMA_PERSIST_DIR="data/chroma_db"
CHROMA_COLLECTION_NAME="getnet_knowledge_base"
KNOWLEDGE_BASE_DIR="data/knowledge_base"
MERCHANTS_DATA_PATH="data/merchants.json"
EVAL_DATASET_PATH="data/eval_dataset.json"
RAG_TOP_K=4
RAG_MIN_SIMILARITY_THRESHOLD=0.35

# --- Optional External Web Search API ---
TAVILY_API_KEY=""

# --- Guardrails, Escalation & SLO Alerting Thresholds ---
CONFIDENCE_ESCALATION_THRESHOLD=0.60
LATENCY_SLO_THRESHOLD_MS=7000.0
LATENCY_SLO_FAST_PATH_MS=7000.0
LATENCY_SLO_COMPLEX_PATH_MS=18000.0
ENABLE_INPUT_GUARDRAILS=true
ENABLE_OUTPUT_GUARDRAILS=true

# --- Observability: LangSmith (Native LangChain / LangGraph Tracing) ---
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="getnet-multi-agent-support"

# --- Observability: Optional Langfuse Integration ---
LANGFUSE_ENABLED="false"
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# --- Local Trace & Alert Persistence ---
TRACE_LOG_PATH="logs/traces.jsonl"
MAX_IN_MEMORY_TRACES=500
